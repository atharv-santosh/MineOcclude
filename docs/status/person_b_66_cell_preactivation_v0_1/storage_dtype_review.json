5bc2847b0ead7"},"step6_frozen_runtime_configuration":{"byte_size":2523,"digest_scope":"repository_canonical_lf_bytes","path":"docs/status/person_a_step6_runtime_acknowledgement_v0_1/frozen_runtime_configuration.json","resolved_from":"role/person-b-analysis","sha256":"ecf3e5700da2ade1ca30290966a77bfb558b6afa3d834a0771007a90c06e9cd7"}},"findings":[{"detail":"The same frozen file pins extraction.stored_dtype=float16, extraction.vector_width=2048 and storage.bytes_per_activation_row=8192.68303094984. 2048 float16 elements occupy 4096 bytes; the declared rate requires a 4-byte element. The float16 declaration is the outlier inside its own file.","evidence":["person_a_frozen_mvp_configuration"],"finding_id":"mvp_yaml_is_internally_inconsistent"},{"detail":"pooled_representation.stored_dtype=float32 with analysis_dtype=float64 is pinned by three accepted contract artifacts that are present on origin/main, not only on Person A's branch.","evidence":["accepted_preflight_activation_contract","accepted_preflight_immutable_runtime_configuration","step6_frozen_runtime_configuration"],"finding_id":"accepted_contracts_already_pin_float32"},{"detail":"Person B's own Phase 6 SageMaker runtime ratification records stored_dtype=float32 and analysis_dtype=float64. Choosing float32 preserves a ratification Person B has already made rather than creating a new one.","evidence":["person_b_sagemaker_runtime_ratification","person_b_fitted_probe_input_contract"],"finding_id":"person_b_already_ratified_float32_storage"},{"detail":"select_and_pool upcasts the selected visual tokens with .to(dtype=torch.float32) and then raises INVALID_RESULT unless pooled.dtype is exactly torch.float32.","evidence":["pooling_implementation"],"finding_id":"implementation_cannot_emit_float16_pooled_vectors"},{"detail":"Person B's accepted v2 consumers fail closed on any loaded activation vector whose dtype is not float32, so float16 storage would require changing Person B code that is already bound to executed evidence.","evidence":["person_b_consumer_production_v2","person_b_consumer_positive_control_v2"],"finding_id":"person_b_consumers_reject_non_float32_vectors"},{"detail":"All ten executed pilots measure ~8192.5-8193.1 bytes per activation row at width 2048, implying a 4.0-byte element.","evidence":["person_a_executed_ten_pilot_certification"],"finding_id":"executed_production_measured_four_byte_elements"},{"detail":"model.precision=float16 and extraction.source_tensor_dtype=float16 are correct and unaffected. The residual stream is hooked in float16; pooling is a separate step. Only the pooled storage dtype was in dispute.","evidence":["person_a_phase5_storage_decision","step6_frozen_runtime_configuration"],"finding_id":"hooked_tensor_dtype_is_a_separate_question"},{"detail":"configs/experiments/mvp.yaml on origin/main (15adc43674420ae35921847a953ebbee2135f142) and on role/person-b-analysis is a 102-byte header stub. The 5958-byte frozen configuration exists only on role/person-a-model. Any successor configuration must therefore be published as a new file identity, not an in-place edit of an accepted run.","evidence":["person_a_frozen_mvp_configuration"],"finding_id":"authoritative_mvp_yaml_is_not_on_main"}],"input_manifest_hash":"64ade0c8506cc32b422186b5dbbe9a34339948b947ec6fea26d282d7cc9c917e","person_b_approvals":{"additional_scientific_review_required":false,"additive_dated_decision_record_required":true,"approved_analysis_arithmetic_dtype":"float64","approved_stored_activation_dtype":"float32","approves_successor_extraction_contract":true,"historical_ten_pilot_artifacts_may_be_rewritten":false,"in_place_edit_of_accepted_run_authorized":false,"new_run_identity_required":true,"person_a_may_create_new_successor_config_and_run_identity":true,"person_b_edited_person_a_mvp_yaml":false},"preactivation_schema_version":"person-b-66-cell-preactivation-v0.1","producer_role":"person_b","resolution_option":"A","result_changing_assessment":{"numerically_result_changing_versus_executed_artifacts":false,"reason":"extraction.stored_dtype is listed as a result-changing path, so the change requires a new run identity and a dated decision record. It changes no produced number, because every executed pooled artifact and the pooling implementation are already float32.","result_changing_by_person_a_step_7_1_register":true},"review_complete":true,"reviewed_proposal":{"commit":"77e43bd1665671b9e23d6d6ef927ee4944611342","path":"docs/status/person_a_66_cell_local_preparation_v0_1/storage_dtype_reconciliation.json","proposal_hash_independently_verified":true,"sha256":"64ade0c8506cc32b422186b5dbbe9a34339948b947ec6fea26d282d7cc9c917e"},"scope_note":"This review resolves the pooled storage dtype only. It does not reopen model precision, hook site, pooling identity, vector width, layer count, or the frozen Step 4.1 FAIL decision."}
