  "predeclared_criterion_clarification": {
    "both_criteria_reported": "spatial_scramble_control.json reports both layout_majority_consistent_by_representation (the applied rule) and every_fold_directionally_consistent_by_representation (the original rule) for both designs and both representations, so a reader can recompute either verdict",
    "classification": "PRE_OUTCOME_INTERPRETATION_CLARIFICATION",
    "qualifications_disclosed": [
      "equal-layout macro scramble outcomes WERE already known when the criterion was changed; only per-fold outcomes were unknown",
      "the change was motivated in part by anticipating, from the frozen Task 4 ordered per-layout values (layout_05 ordered across-layout R2 is negative), that a unanimity rule could fail on a layout whose ordered fit is already poor",
      "the change is material to the reported verdict: under the original unanimity rule STABLE_SPATIAL_IDENTITY_WITHIN_LAYOUT, STABLE_SPATIAL_IDENTITY_ACROSS_LAYOUT and STABLE_SPATIAL_IDENTITY_MATTERS would each read Unclear rather than True"
    ],
    "timing_evidence": [
      "the first pipeline pass crashed in the reporting stage before any spatial_scramble_control.json was written, so no per-fold scramble outcome existed on disk when the criterion was changed",
      "the first pass emitted only equal-layout macro values to its runtime log; no per-fold scramble value was printed",
      "the only spatial_scramble_control.json in the repository was produced by the post-change rerun"
    ],
    "timing_substantiated": true,
    "underlying_magnitudes_unaffected": "the material-advantage component and every macro and per-fold R2 value are identical under both criteria; only the consistency component differs",
    "what_changed": "the Task 5 spatial-identity directional-consistency criterion was implemented first as 'every outer fold favours ordered' and was changed, before any per-fold scramble outcome existed, to the specification-consistent qualitative rule 'for every frozen seed a strict majority of layouts shows a positive median ordered-minus-scrambled delta'",
    "why": "the specification reserves Unclear for evidence that is 'strongly mixed'; requiring unanimity across all 90 seed-by-fold cells is stricter than that language and would classify a single reversal out of 90 as strongly mixed"
  },
