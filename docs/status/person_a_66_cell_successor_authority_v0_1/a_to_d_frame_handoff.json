  "blocking_findings": [
    {
      "blocker_id": "C-66-CELL-640x360-MEDIA-MISSING",
      "blocks_person_a_activation_extraction": true,
      "blocks_person_d_raw_pixel_baseline": true,
      "blocks_scope_note": "The same pinned preprocessing produces Person A's model input and Person D's raw-pixel features, so this gap blocks the activation run itself, not only the Person D baseline.",
      "detail": "Person A's frozen preprocessing requires a 360x640 BGR uint8 source and _preprocess_bgr_frame rejects any other shape. Person C's capture package for the 66 cells declares media width 640 / height 360, but the only materialised pixels are the 1920x1046 raw client framebuffer PNGs, and no 640x360 derivative exists in the repository or on the preparation host for any ep126xx episode. The two aspect ratios differ (1.836 versus 1.778), so any downscale is a scientific choice about cropping or letterboxing. Person A does not invent one.",
      "owner": "person_c_data",
      "resolution_options": [
        "Person C publishes the declared 640x360 media derivative for all 66 episodes, as already exists for the earlier ep94xx and ep100xx pilots (video_640x360.mp4)",
        "a coordinated result-changing decision redefines Person A's frozen preprocessing source resolution and the exact downscale rule"
      ]
    }
  ],
  "canonicalization_rules": {
    "frame_map_row_encoding": "canonical JSON, sorted keys, ASCII, compact separators, one row per line",
