  "latent_state": "sheep world-x in blocks",
  "transition": "x[t+1] = x[t] + s*v*dt + w[t], w[t] ~ N(0, q*dt) i.i.d.",
  "observation_model": {
    "while_directly_visible": "posterior variance collapses to effectively zero",
    "during_stable_opaque_L4_occlusion": "prediction-only propagation; no observation update"
  },
  "tau_definition": "occlusion age 1..19 from t0, the last counterfactually not-fully-occluded row",
  "posterior_mean": "mu_tau = x[t0] + s*v*dt*(tau - gbar_direction)",
  "posterior_variance_EXACT": "sigma2_tau = q*dt * sum_{m=0}^{tau-1} H_direction(m)^2",
  "H_definition": "H(m) = sum_{k=0}^{min(m,8)} h_k, the cumulative normalized FIR mass; H(m)=1 for m>=8",
  "H_normalization_requirement": "H(m) is the cumulative mass of the FSUM-NORMALIZED direction kernel: taps are first rescaled by dividing each tap by math.fsum(taps), THEN accumulated with math.fsum. Normalization is mandatory before any oracle use. The published LEFT_TO_RIGHT taps sum to 0.9999999999 (1.0e-10 short of unit mass) because they are rounded to 10 decimal places; unnormalized taps satisfy a 1e-9 label tolerance but FAIL the 1e-12 S(tau) tolerance of test D.6 by up to 9.29e-10. RIGHT_TO_LEFT taps already sum to exactly 1.0 and are unchanged by normalization.",
  "unnormalized_taps_fail_S_tau_1e_12_tolerance": true,
  "max_S_tau_error_if_unnormalized": {
    "LEFT_TO_RIGHT": 9.289005120649563e-10,
    "RIGHT_TO_LEFT": 0.0
  },
  "posterior_sigma": "sigma_tau = sqrt(sigma2_tau), in blocks",
  "affine_reduction": "sigma2_tau = q*dt*(tau + c_direction) for tau >= 8 ONLY",
  "affine_form_must_not_be_used_below_tau_8": true,
