{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://mineocclude.local/schemas/person_c/capture_v0_1.schema.json",
  "title": "MineOcclude Person C capture package v0.1",
  "description": "Additive producer contract layered on frozen shared schema 1.0.",
  "type": "object",
  "required": [
    "schema_version",
    "person_c_contract_version",
    "episode_id",
    "trajectory_id",
    "layout_id",
    "run_id",
    "condition",
    "seed",
    "synthetic",
    "scientific_use",
    "media",
    "artifacts",
    "streams",
    "episode_manifest",
    "exclusion_ledger",
    "impulse_orientation",
    "temporal_alignment"
  ],
  "properties": {
    "schema_version": {"const": "1.0"},
    "person_c_contract_version": {"const": "0.1"},
    "episode_id": {"$ref": "#/$defs/nonEmptyString"},
    "trajectory_id": {"$ref": "#/$defs/nonEmptyString"},
    "layout_id": {"$ref": "#/$defs/nonEmptyString"},
    "run_id": {"$ref": "#/$defs/nonEmptyString"},
    "condition": {"$ref": "#/$defs/nonEmptyString"},
    "seed": {"type": "integer", "x-unit": "dimensionless"},
    "synthetic": {"type": "boolean"},
    "scientific_use": {"type": "string"},
    "media": {"$ref": "#/$defs/media"},
    "artifacts": {
      "type": "object",
      "required": ["raw_actions", "normalized_actions", "server_state", "client_tick_log", "frame_map", "visibility", "config", "seed_noise", "diagnostics"],
      "properties": {
        "raw_actions": {"$ref": "#/$defs/jsonlArtifact"},
        "normalized_actions": {"$ref": "#/$defs/jsonlArtifact"},
        "server_state": {"$ref": "#/$defs/jsonlArtifact"},
        "client_tick_log": {"$ref": "#/$defs/jsonlArtifact"},
        "frame_map": {"$ref": "#/$defs/jsonlArtifact"},
        "visibility": {"$ref": "#/$defs/jsonlArtifact"},
        "config": {"$ref": "#/$defs/jsonArtifact"},
        "seed_noise": {"$ref": "#/$defs/jsonlArtifact"},
        "diagnostics": {"$ref": "#/$defs/jsonArtifact"}
      },
      "additionalProperties": false
    },
    "streams": {
      "type": "object",
      "required": [
        "frame_map",
        "raw_actions",
        "normalized_actions",
        "server_state",
        "client_tick_log",
        "visibility",
        "seed_noise"
      ],
      "properties": {
        "frame_map": {"type": "array", "items": {"$ref": "#/$defs/frameMapRow"}},
        "raw_actions": {"type": "array", "items": {"$ref": "#/$defs/rawActionRow"}},
        "normalized_actions": {"type": "array", "items": {"$ref": "#/$defs/normalizedActionRow"}},
        "server_state": {"type": "array", "items": {"$ref": "#/$defs/serverStateRow"}},
        "client_tick_log": {"type": "array", "items": {"$ref": "#/$defs/clientTickRow"}},
        "visibility": {"type": "array", "items": {"$ref": "#/$defs/visibilityRow"}},
        "seed_noise": {"type": "array", "items": {"$ref": "#/$defs/noiseRow"}}
      },
      "additionalProperties": false
    },
    "episode_manifest": {"$ref": "#/$defs/episodeManifest"},
    "exclusion_ledger": {
      "type": "array",
      "items": {"$ref": "#/$defs/exclusionEntry"}
    },
    "impulse_orientation": {"type": "object"},
    "temporal_alignment": {"$ref": "#/$defs/temporalAlignment"}
  },
  "additionalProperties": true,
  "$defs": {
    "nonEmptyString": {"type": "string", "minLength": 1},
    "sha256": {"type": "string", "pattern": "^[0-9a-fA-F]{64}$"},
    "gitSha": {"type": "string", "pattern": "^[0-9a-fA-F]{40}$"},
    "jsonlArtifact": {
      "type": "object",
      "required": ["path", "format", "sha256"],
      "properties": {
        "path": {"$ref": "#/$defs/nonEmptyString"},
        "format": {"const": "jsonl"},
        "sha256": {"$ref": "#/$defs/sha256"}
      },
      "additionalProperties": false
    },
    "jsonArtifact": {
      "type": "object",
      "required": ["path", "format", "sha256"],
      "properties": {
        "path": {"$ref": "#/$defs/nonEmptyString"},
        "format": {"const": "json"},
        "sha256": {"$ref": "#/$defs/sha256"}
      },
      "additionalProperties": false
    },
    "nonNegativeIndex": {"type": "integer", "minimum": 0, "x-unit": "dimensionless index"},
    "captureIdentityProperties": {
      "type": "object",
      "properties": {
        "episode_id": {"$ref": "#/$defs/nonEmptyString"},
        "trajectory_id": {"$ref": "#/$defs/nonEmptyString"},
        "server_tick": {"type": "integer", "minimum": 0, "x-unit": "server ticks at 20 Hz"},
        "render_frame_idx": {"type": "integer", "minimum": 0, "x-unit": "render frames"},
        "action_idx": {"type": "integer", "minimum": 0, "x-unit": "dimensionless action index"},
        "model_frame_idx": {"type": "integer", "minimum": 0, "x-unit": "model frames"}
      }
    },
    "frameMapRow": {
      "type": "object",
      "required": ["episode_id", "trajectory_id", "server_tick", "render_frame_idx", "action_idx", "model_frame_idx"],
      "properties": {
        "episode_id": {"$ref": "#/$defs/nonEmptyString"},
        "trajectory_id": {"$ref": "#/$defs/nonEmptyString"},
        "server_tick": {"type": "integer", "minimum": 0, "x-unit": "server ticks at 20 Hz"},
        "render_frame_idx": {"type": "integer", "minimum": 0, "x-unit": "render frames"},
        "action_idx": {"type": "integer", "minimum": 0, "x-unit": "dimensionless action index"},
        "model_frame_idx": {"type": "integer", "minimum": 0, "x-unit": "model frames"}
      },
      "additionalProperties": true
    },
    "rawActionRow": {
      "allOf": [
        {"$ref": "#/$defs/frameMapRow"},
        {
          "type": "object",
          "required": ["raw_action"],
          "properties": {
            "raw_action": {
              "type": "object",
              "minProperties": 1,
              "$comment": "Exact raw vocabulary is an unresolved A/C decision."
            }
          }
        }
      ]
    },
    "normalizedActionRow": {
      "allOf": [
        {"$ref": "#/$defs/frameMapRow"},
        {
          "type": "object",
          "required": ["normalized_action"],
          "properties": {
            "normalized_action": {
              "type": "object",
              "required": ["camera_component_0", "camera_component_1", "hotbar", "forward_back", "left_right", "sprint_sneak", "use_attack", "jump", "drop_pick_item"],
              "properties": {
                "camera_component_0": {"type": "integer", "x-unit": "dimensionless MineWorld action code"},
                "camera_component_1": {"type": "integer", "x-unit": "dimensionless MineWorld action code"},
                "hotbar": {"type": "integer", "x-unit": "dimensionless MineWorld action code"},
                "forward_back": {"type": "integer", "x-unit": "dimensionless MineWorld action code"},
                "left_right": {"type": "integer", "x-unit": "dimensionless MineWorld action code"},
                "sprint_sneak": {"type": "integer", "x-unit": "dimensionless MineWorld action code"},
                "use_attack": {"type": "integer", "x-unit": "dimensionless MineWorld action code"},
                "jump": {"type": "integer", "x-unit": "dimensionless MineWorld action code"},
                "drop_pick_item": {"type": "integer", "x-unit": "dimensionless MineWorld action code"}
              },
              "additionalProperties": false
            }
          }
        }
      ]
    },
    "serverStateRow": {
      "allOf": [
        {"$ref": "#/$defs/frameMapRow"},
        {
          "type": "object",
          "required": ["state"],
          "properties": {
            "state": {
              "type": "object",
              "required": ["target_entity_id", "target_present", "position_x_blocks", "position_y_blocks", "position_z_blocks", "wall_parallel_position_blocks", "velocity_x_blocks_per_second", "velocity_y_blocks_per_second", "velocity_z_blocks_per_second"],
              "properties": {
                "target_entity_id": {"$ref": "#/$defs/nonEmptyString"},
                "target_present": {"type": "boolean"},
                "position_x_blocks": {"type": "number", "x-unit": "blocks"},
                "position_y_blocks": {"type": "number", "x-unit": "blocks"},
                "position_z_blocks": {"type": "number", "x-unit": "blocks"},
                "wall_parallel_position_blocks": {"type": "number", "x-unit": "blocks"},
                "velocity_x_blocks_per_second": {"type": "number", "x-unit": "blocks per second"},
                "velocity_y_blocks_per_second": {"type": "number", "x-unit": "blocks per second"},
                "velocity_z_blocks_per_second": {"type": "number", "x-unit": "blocks per second"}
              },
              "additionalProperties": true
            }
          }
        }
      ]
    },
    "clientTickRow": {
      "allOf": [
        {"$ref": "#/$defs/frameMapRow"},
        {"type": "object", "required": ["client_tick"], "properties": {"client_tick": {"type": "integer", "minimum": 0, "x-unit": "client ticks"}}}
      ]
    },
    "visibilityRow": {
      "allOf": [
        {"$ref": "#/$defs/frameMapRow"},
        {"type": "object", "required": ["visibility"], "properties": {"visibility": {"$ref": "#/$defs/nonEmptyString"}}}
      ]
    },
    "noiseRow": {
      "allOf": [
        {"$ref": "#/$defs/frameMapRow"},
        {
          "type": "object",
          "required": ["seed", "draw_idx", "standard_normal_draw", "q", "dt_seconds", "noise_std_blocks", "noise_draw"],
          "properties": {
            "seed": {"type": "integer", "x-unit": "dimensionless"},
            "draw_idx": {"type": "integer", "minimum": 0, "x-unit": "dimensionless draw index"},
            "standard_normal_draw": {"type": "number", "x-unit": "dimensionless"},
            "q": {"type": "number", "minimum": 0, "x-unit": "blocks squared per second"},
            "dt_seconds": {"type": "number", "const": 0.05, "x-unit": "seconds"},
            "noise_std_blocks": {"type": "number", "minimum": 0, "x-unit": "blocks"},
            "noise_draw": {"type": "number", "x-unit": "blocks"}
          }
        }
      ]
    },
    "media": {
      "type": "object",
      "required": ["mode", "path", "width", "height", "fps", "frame_count", "sha256"],
      "properties": {
        "mode": {"enum": ["mp4", "numbered_frames"]},
        "path": {"$ref": "#/$defs/nonEmptyString"},
        "width": {"type": "integer", "const": 640, "x-unit": "pixels"},
        "height": {"type": "integer", "const": 360, "x-unit": "pixels"},
        "fps": {"type": "number", "const": 20.0, "x-unit": "frames per second"},
        "frame_count": {"type": "integer", "minimum": 1, "x-unit": "frames"},
        "sha256": {"$ref": "#/$defs/sha256"}
      },
      "additionalProperties": false
    },
    "episodeManifest": {
      "type": "object",
      "required": ["schema_version", "person_c_contract_version", "episode_id", "trajectory_id", "layout_id", "run_id", "condition", "regime", "seed", "tick_rate_hz", "dt_seconds", "q", "v", "duration", "code_sha", "config_hash", "layout_config_hash", "environment_lock_hash", "noise_schedule_hash", "rng", "lifecycle_version", "status"],
      "properties": {
        "schema_version": {"const": "1.0"},
        "person_c_contract_version": {"const": "0.1"},
        "episode_id": {"$ref": "#/$defs/nonEmptyString"},
        "trajectory_id": {"$ref": "#/$defs/nonEmptyString"},
        "layout_id": {"$ref": "#/$defs/nonEmptyString"},
        "run_id": {"$ref": "#/$defs/nonEmptyString"},
        "condition": {"$ref": "#/$defs/nonEmptyString"},
        "regime": {"$ref": "#/$defs/nonEmptyString"},
        "seed": {"type": "integer", "x-unit": "dimensionless"},
        "tick_rate_hz": {"type": "number", "const": 20.0, "x-unit": "ticks per second"},
        "dt_seconds": {"type": "number", "const": 0.05, "x-unit": "seconds"},
        "q": {"type": "number", "minimum": 0, "x-unit": "blocks squared per second"},
        "v": {"type": "number", "x-unit": "blocks per second"},
        "duration": {"type": "number", "minimum": 0, "x-unit": "seconds"},
        "code_sha": {"$ref": "#/$defs/gitSha"},
        "config_hash": {"$ref": "#/$defs/sha256"},
        "layout_config_hash": {"$ref": "#/$defs/sha256"},
        "environment_lock_hash": {"$ref": "#/$defs/sha256"},
        "noise_schedule_hash": {"$ref": "#/$defs/sha256"},
        "rng": {
          "type": "object",
          "required": ["producer", "bit_generator", "numpy_version", "immutable_schedule", "java_consumption"],
          "properties": {
            "producer": {"const": "numpy.random.Generator"},
            "bit_generator": {"const": "PCG64"},
            "numpy_version": {"$ref": "#/$defs/nonEmptyString"},
            "immutable_schedule": {"const": true},
            "java_consumption": {"const": "stored_draws_in_draw_idx_order"}
          }
        },
        "lifecycle_version": {"$ref": "#/$defs/nonEmptyString"},
        "status": {"enum": ["accepted", "excluded", "superseded"]}
      },
      "additionalProperties": false
    },
    "exclusionEntry": {
      "type": "object",
      "required": ["exclusion_id", "schema_version", "person_c_contract_version", "episode_id", "trajectory_id", "run_id", "status", "exclusion_reason", "rejection_codes", "recorded_at_utc", "source_artifact_hash", "superseded_by"],
      "properties": {
        "exclusion_id": {"$ref": "#/$defs/nonEmptyString"},
        "schema_version": {"const": "1.0"},
        "person_c_contract_version": {"const": "0.1"},
        "episode_id": {"$ref": "#/$defs/nonEmptyString"},
        "trajectory_id": {"$ref": "#/$defs/nonEmptyString"},
        "run_id": {"$ref": "#/$defs/nonEmptyString"},
        "status": {"const": "excluded"},
        "exclusion_reason": {"$ref": "#/$defs/nonEmptyString"},
        "rejection_codes": {"type": "array", "minItems": 1, "items": {"$ref": "#/$defs/nonEmptyString"}},
        "recorded_at_utc": {"type": "string", "format": "date-time"},
        "source_artifact_hash": {"$ref": "#/$defs/sha256"},
        "superseded_by": {"type": "null"}
      },
      "additionalProperties": false
    },
    "temporalAlignment": {
      "type": "object",
      "required": ["status", "evidence_scope", "action_idx", "visual_before_model_frame_idx", "visual_after_model_frame_idx", "effect_server_tick", "evidence_hash"],
      "properties": {
        "status": {"const": "verified"},
        "evidence_scope": {"const": "synthetic_contract_only"},
        "action_idx": {"type": "integer", "minimum": 0, "x-unit": "dimensionless action index"},
        "visual_before_model_frame_idx": {"type": "integer", "minimum": 0, "x-unit": "model frames"},
        "visual_after_model_frame_idx": {"type": "integer", "minimum": 0, "x-unit": "model frames"},
        "effect_server_tick": {"type": "integer", "minimum": 0, "x-unit": "server ticks at 20 Hz"},
        "evidence_hash": {"$ref": "#/$defs/sha256"}
      },
      "additionalProperties": false
    }
  }
}
