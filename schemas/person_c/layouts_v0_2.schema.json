{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://mineocclude.local/schemas/person_c/layouts_v0_2.schema.json",
  "title": "MineOcclude Person C layouts v0.2 marker-role extension",
  "type": "object",
  "required": [
    "schema_version",
    "person_c_contract_version",
    "layout_schema_version",
    "config_version",
    "common_arena_grammar",
    "conditions",
    "layouts"
  ],
  "properties": {
    "schema_version": {"const": "1.0"},
    "person_c_contract_version": {"const": "0.1"},
    "layout_schema_version": {"const": "0.2"},
    "config_version": {"const": "person-c-layout-config-v0.2"},
    "common_arena_grammar": {"type": "object"},
    "conditions": {"type": "array", "minItems": 3, "maxItems": 3},
    "layouts": {
      "type": "array",
      "minItems": 6,
      "maxItems": 6,
      "items": {
        "type": "object",
        "required": ["layout_id", "config_version", "markers"],
        "properties": {
          "layout_id": {"type": "string", "minLength": 1},
          "config_version": {"const": "person-c-layout-config-v0.2"},
          "markers": {
            "type": "array",
            "minItems": 4,
            "maxItems": 4,
            "items": {
              "type": "object",
              "required": [
                "marker_id",
                "marker_role",
                "block",
                "color",
                "world_blocks",
                "intended_visible",
                "visibility_evidence"
              ],
              "properties": {
                "marker_id": {"type": "string", "minLength": 1},
                "marker_role": {
                  "enum": ["north_west", "north_east", "south_east", "south_west"]
                },
                "block": {"type": "string", "minLength": 1},
                "color": {"type": "string", "minLength": 1, "not": {"const": "magenta"}},
                "world_blocks": {
                  "type": "object",
                  "required": ["x", "y", "z"],
                  "properties": {
                    "x": {"type": "number", "x-unit": "world blocks"},
                    "y": {"type": "number", "x-unit": "world blocks"},
                    "z": {"type": "number", "x-unit": "world blocks"}
                  },
                  "additionalProperties": false
                },
                "intended_visible": {"const": true},
                "visibility_evidence": {"const": "RUNTIME EVIDENCE REQUIRED LATER"}
              },
              "additionalProperties": false
            }
          }
        }
      }
    }
  }
}
